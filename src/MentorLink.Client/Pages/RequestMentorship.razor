@page "/request/{MentorUserId:int}"
@layout AppLayout
@inject Api Api
@inject AppState State
@inject NavigationManager Nav

<PageTitle>Request Mentorship — MentorLink</PageTitle>

<div class="req-wrap">
    @if (mentor is null)
    {
        <div class="loading">Loading…</div>
    }
    else if (sent)
    {
        <div class="card" style="padding:40px; text-align:center">
            <h1 style="font-size:20px; margin-bottom:8px">Request sent</h1>
            <p class="mut" style="margin-bottom:22px">@mentor.Card.Name will be notified and usually responds within a couple of days.</p>
            <a href="/mentorships"><span class="btn btn-dark">View My Mentorships</span></a>
        </div>
    }
    else
    {
        <div class="card" style="padding:32px 34px">
            <div class="req-head">
                <Avatar Name="@mentor.Card.Name" Size="md" />
                <div>
                    <h1>Request Mentorship from @mentor.Card.Name</h1>
                    <p class="mut small">@mentor.Card.Title · @mentor.Card.Company</p>
                </div>
            </div>

            @if (error is not null)
            {
                <div class="form-error">@error</div>
            }

            <div class="field">
                <label for="rq-goal">Goal Type</label>
                <select class="inp" id="rq-goal" @bind="goalType">
                    <option value="@GoalType.Academic">Academic</option>
                    <option value="@GoalType.Career">Career</option>
                    <option value="@GoalType.Leadership">Leadership</option>
                    <option value="@GoalType.Entrepreneurship">Entrepreneurship</option>
                    <option value="@GoalType.PersonalGrowth">Personal Growth</option>
                </select>
            </div>

            <div class="field">
                <label for="rq-msg">Message to Mentor</label>
                <textarea class="inp" id="rq-msg" placeholder="Tell them what you're hoping to achieve..." @bind="message"></textarea>
            </div>

            <div class="field">
                <label for="rq-freq">Preferred Meeting Frequency</label>
                <select class="inp" id="rq-freq" @bind="frequency">
                    <option>Weekly</option>
                    <option>Biweekly</option>
                    <option>Monthly</option>
                </select>
            </div>

            <button class="btn btn-dark btn-lg" disabled="@busy" @onclick="Send">
                @(busy ? "Sending…" : "Send Request")
            </button>
            <button class="cancel" @onclick="Cancel">Cancel</button>
        </div>
    }
</div>

@code {
    [Parameter] public int MentorUserId { get; set; }

    private MentorProfileDto? mentor;
    private GoalType goalType = GoalType.Career;
    private string message = "";
    private string frequency = "Weekly";
    private string? error;
    private bool busy, sent;

    protected override async Task OnParametersSetAsync()
        => mentor = await Api.GetMentorProfileAsync(MentorUserId);

    private async Task Send()
    {
        error = null;
        if (State.CurrentUser is null) return;
        if (string.IsNullOrWhiteSpace(message))
        {
            error = "Tell the mentor what you're hoping to achieve — it makes a yes much more likely.";
            return;
        }

        busy = true;
        var ok = await Api.CreateRequestAsync(new CreateMentorshipRequest(
            State.CurrentUser.Id, MentorUserId, goalType, message, frequency));
        busy = false;

        if (ok) sent = true;
        else error = "Something went wrong sending your request — try again.";
    }

    private void Cancel() => Nav.NavigateTo($"/mentor/{MentorUserId}");
}
