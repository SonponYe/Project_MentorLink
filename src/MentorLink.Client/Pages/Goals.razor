@page "/goals"
@layout AppLayout
@inject Api Api
@inject AppState State

<PageTitle>My Goals — MentorLink</PageTitle>

<div class="pagehead">
    <h1>My Goals</h1>
    <button class="btn btn-dark" @onclick="() => showAdd = !showAdd"><Icon Name="plus" Size="15" />Add Goal</button>
</div>

@if (showAdd)
{
    <div class="card" style="margin-bottom:18px; padding:24px">
        <span class="lab" style="display:block; margin-bottom:14px">New Goal</span>
        <div class="fgrid">
            <div class="field">
                <label for="g-title">Goal title</label>
                <input class="inp" id="g-title" placeholder="e.g. Publish my first research paper" @bind="newTitle" />
            </div>
            <div class="field">
                <label for="g-type">Category</label>
                <select class="inp" id="g-type" @bind="newType">
                    <option value="@GoalType.Academic">Academic</option>
                    <option value="@GoalType.Career">Career</option>
                    <option value="@GoalType.Leadership">Leadership</option>
                    <option value="@GoalType.Entrepreneurship">Entrepreneurship</option>
                    <option value="@GoalType.PersonalGrowth">Personal Growth</option>
                </select>
            </div>
            <div class="field wide">
                <label for="g-miles">Milestones (one per line)</label>
                <textarea class="inp" id="g-miles" style="min-height:84px"
                          placeholder="First milestone&#10;Second milestone&#10;Third milestone" @bind="newMilestones"></textarea>
            </div>
        </div>
        <div class="row" style="justify-content:flex-end; gap:10px">
            <button class="btn btn-ghost btn-sm" @onclick="() => showAdd = false">Cancel</button>
            <button class="btn btn-dark btn-sm" @onclick="AddGoal">Create Goal</button>
        </div>
    </div>
}

@if (goals is null)
{
    <div class="loading">Loading your goals…</div>
}
else if (goals.Count == 0)
{
    <div class="empty-tab">No goals yet — add your first one above.</div>
}
else
{
    @foreach (var goal in goals)
    {
        <div class="card goal-card @(goal.Status == GoalStatus.Completed ? "done" : "")">
            <div class="gleft">
                <span class="chip">@Label(goal.Type)</span>
                <h3>@goal.Title</h3>
                <span class="mut">with @goal.MentorName</span>
            </div>
            <div class="gmiles">
                @foreach (var milestone in goal.Milestones)
                {
                    <label class="mile">
                        <input type="checkbox" checked="@milestone.IsDone" @onchange="() => Toggle(milestone.Id)" />
                        <span>@milestone.Title</span>
                    </label>
                }
            </div>
            <div class="gright">
                <div class="ring">
                    <svg width="74" height="74" viewBox="0 0 74 74">
                        <circle class="trk" cx="37" cy="37" r="31" fill="none" stroke-width="6" />
                        <circle class="val" cx="37" cy="37" r="31" fill="none" stroke-width="6"
                                stroke-dasharray="194.8" stroke-dashoffset="@Offset(goal.Progress)" />
                    </svg>
                    <b>@(goal.Progress)%</b>
                </div>
                @if (goal.Status == GoalStatus.Completed)
                {
                    <span class="badge" style="background:#fff;color:var(--ink)">Completed</span>
                }
                else
                {
                    <span class="badge badge-grey">In Progress</span>
                }
            </div>
        </div>
    }
}

@code {
    private List<GoalDto>? goals;
    private bool showAdd;
    private string newTitle = "", newMilestones = "";
    private GoalType newType = GoalType.Academic;

    protected override async Task OnInitializedAsync()
    {
        await State.EnsureLoadedAsync();
        if (State.CurrentUser is null) return;
        goals = await Api.GetGoalsAsync(State.CurrentUser.Id);
    }

    private async Task Toggle(int milestoneId)
    {
        var updated = await Api.ToggleMilestoneAsync(milestoneId);
        if (updated is not null && goals is not null)
        {
            var index = goals.FindIndex(g => g.Id == updated.Id);
            if (index >= 0) goals[index] = updated;
        }
    }

    private async Task AddGoal()
    {
        if (State.CurrentUser is null || string.IsNullOrWhiteSpace(newTitle)) return;
        var milestones = newMilestones
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        var created = await Api.CreateGoalAsync(new CreateGoalRequest(
            State.CurrentUser.Id, newTitle, newType, null, milestones));
        if (created is not null)
        {
            goals?.Insert(0, created);
            newTitle = ""; newMilestones = ""; showAdd = false;
        }
    }

    private static string Offset(int progress)
        => (194.8 - 194.8 * progress / 100.0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);

    private static string Label(GoalType type) => type == GoalType.PersonalGrowth ? "Personal Growth" : type.ToString();
}
