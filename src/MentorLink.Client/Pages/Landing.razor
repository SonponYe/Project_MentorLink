@page "/"
@layout PublicLayout

<PageTitle>MentorLink — Find Your Mentor. Shape Your Future.</PageTitle>

<div class="land">
    <div class="nav">
        <a class="logo-inline" href="/">
            <span class="mark"><Icon Name="link" Size="15" /></span>MentorLink
        </a>
        <div class="links">
            <a class="mut" href="/#features">Features</a>
            <a class="mut" href="/#how">How It Works</a>
            <a class="mut" href="/signup">Sign Up</a>
            <a href="/login"><span class="btn btn-out btn-sm">Log In</span></a>
        </div>
    </div>

    <div class="hero">
        <h1>Find Your Mentor.<br />Shape Your Future.</h1>
        <p>MentorLink connects ambitious students with experienced professionals for structured, goal-driven mentorship — from first conversation to finished milestone.</p>
        <div class="cta">
            <a href="/signup"><span class="btn btn-dark">Get Started</span></a>
            <a href="/#how"><span class="btn btn-out">Learn More</span></a>
        </div>
    </div>

    <div class="feat" id="features">
        <div class="card card-dark">
            <div class="icon"><Icon Name="users" Size="19" /></div>
            <h3>Mentorship</h3>
            <p>Get matched with verified mentors in your field of study or target industry, and build a relationship that lasts beyond one call.</p>
        </div>
        <div class="card card-dark">
            <div class="icon"><Icon Name="chat" Size="19" /></div>
            <h3>Real-Time Chat</h3>
            <p>Message your mentor directly inside MentorLink — powered by SignalR, so conversations land instantly, in one place.</p>
        </div>
        <div class="card card-dark">
            <div class="icon"><Icon Name="flag" Size="19" /></div>
            <h3>Goal Tracking</h3>
            <p>Break big ambitions into milestones, track progress together, and celebrate every goal you complete along the way.</p>
        </div>
    </div>

    <div class="how" id="how">
        <div class="inner">
            <h2>How It Works</h2>
            <div class="steps">
                <div class="step">
                    <div class="num">1</div>
                    <h4>Create your profile</h4>
                    <p>Sign up as a student or mentor, tell us your field, and set the goals you want to work toward.</p>
                </div>
                <div class="step">
                    <div class="num">2</div>
                    <h4>Find your match</h4>
                    <p>Browse verified mentors by expertise, availability, and rating — then send a mentorship request that explains what you're after.</p>
                </div>
                <div class="step">
                    <div class="num">3</div>
                    <h4>Grow together</h4>
                    <p>Chat in real time, set milestones, and track your progress until every goal is checked off.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="testi">
        <h2>What students are saying</h2>
        <div class="grid">
            <div class="quote">
                <p>"My mentor helped me turn a vague interest in data into a real internship offer. The milestone tracker kept me honest every single week."</p>
                <div class="who">
                    <Avatar Name="Amara Osei" Size="sm" />
                    <div><b>Amara Osei</b><span>Computer Science, Year 3</span></div>
                </div>
            </div>
            <div class="quote">
                <p>"I'd never had anyone in my corner from the design industry before. Six months on MentorLink changed how I think about my portfolio."</p>
                <div class="who">
                    <Avatar Name="David Kim" Size="sm" />
                    <div><b>David Kim</b><span>Visual Communication, Year 2</span></div>
                </div>
            </div>
            <div class="quote">
                <p>"The chat makes it feel like my mentor is right there. Quick questions get quick answers — and the big questions get real sessions."</p>
                <div class="who">
                    <Avatar Name="Priya Sharma" Size="sm" />
                    <div><b>Priya Sharma</b><span>Statistics, Final Year</span></div>
                </div>
            </div>
        </div>
    </div>

    <div class="foot">
        <div class="logo-inline inv">
            <span class="mark"><Icon Name="link" Size="15" /></span>MentorLink
        </div>
        <div class="flinks">
            <a href="/#features">Features</a>
            <a href="/#how">How It Works</a>
            <a href="/">Privacy</a>
            <a href="/">Terms</a>
            <a href="/">Contact</a>
        </div>
        <div class="copy">© 2026 MentorLink. All rights reserved.</div>
    </div>
</div>
